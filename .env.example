# Public Vercel origin, without a trailing slash
FRONTEND_URL=https://zanexyuu-asset-uploader.vercel.app
BACKEND_URL=https://zanexyuu-railway.up.railway.app
NODE_ENV=production
# Set true only when Railway is configured as a trusted reverse proxy
TRUST_PROXY=false

# Optional legacy fallback. Leave blank when every user supplies their own Roblox key.
ROBLOX_API_KEY=
ROBLOX_CREATOR_TYPE=user
ROBLOX_CREATOR_ID=

# Discord Developer Portal OAuth application
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Google Cloud OAuth 2.0 web application
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Roblox Creator Dashboard OAuth 2.0 app used by Connect Roblox
ROBLOX_OAUTH_CLIENT_ID=
ROBLOX_OAUTH_CLIENT_SECRET=
ROBLOX_OAUTH_REDIRECT_URI=https://zanexyuu-railway.up.railway.app/auth/roblox/callback

# Discord bot token and server/role used for membership and premium checks
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_PREMIUM_ROLE_ID=

# Railway PostgreSQL supplies this automatically when the database is linked
DATABASE_URL=

# Required to encrypt Roblox API keys while operations are being polled
OPERATION_ENCRYPTION_KEY=
